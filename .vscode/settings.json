{
  "C_Cpp.intelliSenseEngine": "default",

  "cmake.configureOnEdit": false,
  "cmake.configureOnOpen": false,
  
  "idf.telemetry": false,
  "idf.showOnboardingOnInit": false,

  // clangd configuration
  "clangd.path": "D:\\espressif\\v6.1\\tools\\tools\\esp-clangd\\esp-21.1.3_20260408\\esp-clangd\\bin\\clangd.exe",
  "clangd.arguments": [
    "--background-index",
    "--query-driver=**",
    "--compile-commands-dir=d:\\Projects\\GillesZunino-GitHub\\esp32-holiday-tree/build-devboard-debug"
  ],

  //
  // ESP-IDF - Extension wide settings for the configuration [VS Code v2.0.x] [EIM v0.8.0]
  //
  //  * "idf.eimIdfJsonPath": "D:\\espressif\\eim_idf.json"
  //  * "idf.eimExecutableArgs": [
  //      "gui"
  //    ]
  //
  //  ESP-IDF Per project (settings.json) configurations [VS Code v2.0.x] [EIM v0.8.0]
  //  * "idf.currentSetup": Path to the selected ESP-IDF version to use (aka D:\\espressif\\vx.y.z\\esp-idf)
  //
  "idf.currentSetup": "D:\\espressif\\v6.1\\esp-idf",

  "idf.customExtraVars": {
    "IDF_TARGET": "esp32"
  },

  "idf.extraCleanPaths": [ "build", "build-devboard-debug", "build-devboard-release", "build-smartbutton-debug", "build-smartbutton-release", "cmake-build-debug",  "sdkconfig", "sdkconfig.old", "managed_components" ],

  "idf.openOcdDebugLevel": 2,
  "idf.openOcdConfigs": [
    //
    // Use one of the configurations below:
    // * "openocd/esp32-ft2232hl-to-jtag.cfg" for ESP32 JTAG via USB to FT2232HL (2 channels) - Configured for Interface 1 (Channel B)
    // * "openocd/esp32-ft4232hl-to-jtag.cfg" for ESP32 JTAG via USB to FT4232HL (4 channels) - Configured for Interface 1 (Channel B)
    // * "openocd/esp32-s3-builtin-usb-to-jtag.cfg" for ESP32-S3 built-in JTAG via USB to dev board
    //
    //"openocd/esp32-ft2232hl-to-jtag.cfg"
    //"openocd/esp32-s3-builtin-usb-to-jtag.cfg"
    "openocd/esp32-ft4232hl-to-jtag.cfg"
  ],
  "idf.openOcdLaunchArgs": [
    "-d${config:idf.openOcdDebugLevel}",
    "-f", "${config:idf.openOcdConfigs}",
    "-s", "${workspaceFolder}",
  ],

  "idf.monitorNoReset": false,
  "idf.launchMonitorOnDebugSession": true,
  "idf.enableSizeTaskAfterBuildTask": true,

  "idf.qemuDebugMonitor": false,
  "idf.qemuExtraArgs": [],

  // SVD files from https://github.com/espressif/svd/tree/main/svd
  "idf.svdFilePath": "${workspaceFolder}/svd/${env:IDF_TARGET}.svd",

  "idf.flashType": "JTAG",
  "idf.port": "COM5"
}